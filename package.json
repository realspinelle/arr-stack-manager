{
    "scripts": {
        "dev:server": "cd server && bun --watch --no-clear-screen src/index.ts",
        "dev:client": "cd client && bun run dev",
        "dev": "concurrently -n 'server,client' -c 'green,blue' 'bun run dev:server' 'bun run dev:client'",
        "build": "cd client && bun run build"
    },
    "dependencies": {
        "concurrently": "^9.2.1"
    }
}